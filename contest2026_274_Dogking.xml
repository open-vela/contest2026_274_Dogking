              dest="apps/nshlib/nsh_netcmds.c"/>
    <linkfile src="board/a733-cubie-a7z/openvela-overlay/apps/system/nsh/nsh_main.c"
              dest="apps/system/nsh/nsh_main.c"/>

    <linkfile src="board/a733-cubie-a7z/openvela-overlay/nuttx/CMakeLists.txt"
              dest="nuttx/CMakeLists.txt"/>
    <linkfile src="board/a733-cubie-a7z/openvela-overlay/nuttx/arch/arm64/src/common/arm64_fatal.c"
              dest="nuttx/arch/arm64/src/common/arm64_fatal.c"/>
    <linkfile src="board/a733-cubie-a7z/openvela-overlay/nuttx/arch/arm64/src/common/arm64_syscall.c"
              dest="nuttx/arch/arm64/src/common/arm64_syscall.c"/>
    <linkfile src="board/a733-cubie-a7z/openvela-overlay/nuttx/fs/fat/fs_fat32dirent.c"
              dest="nuttx/fs/fat/fs_fat32dirent.c"/>
    <linkfile src="board/a733-cubie-a7z/openvela-overlay/nuttx/include/nuttx/npu/a733_vip2.h"
              dest="nuttx/include/nuttx/npu/a733_vip2.h"/>
    <linkfile src="board/a733-cubie-a7z/openvela-overlay/nuttx/libs/libc/misc/lib_utsname.c"
              dest="nuttx/libs/libc/misc/lib_utsname.c"/>
    <linkfile src="board/a733-cubie-a7z/openvela-overlay/nuttx/sched/init/nx_bringup.c"
