              dest="apps/external/libssh/libssh/examples/ssh_server.c"/>
    <linkfile src="board/a733-cubie-a7z/openvela-overlay/apps/external/libssh/libssh/examples/ssh_client.c"
              dest="apps/external/libssh/libssh/examples/ssh_client.c"/>
    <linkfile src="board/a733-cubie-a7z/openvela-overlay/apps/external/libssh/libssh/examples/libssh_scp.c"
              dest="apps/external/libssh/libssh/examples/libssh_scp.c"/>
    <linkfile src="board/a733-cubie-a7z/openvela-overlay/apps/include/netutils/ftpd.h"
              dest="apps/include/netutils/ftpd.h"/>
    <linkfile src="board/a733-cubie-a7z/openvela-overlay/apps/netutils/ftpd"
              dest="apps/netutils/ftpd"/>
    <linkfile src="board/a733-cubie-a7z/openvela-overlay/apps/netutils/iperf/iperf.c"
              dest="apps/netutils/iperf/iperf.c"/>
