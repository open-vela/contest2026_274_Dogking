+static uint64_t pet_http_ms(void)
+{
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (uint64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+/* Absolute response budget, not a fresh timeout per fragment. */
+static int pet_tls_read(tls_ctx_t *ctx, unsigned char *buf, size_t cap,
+    uint64_t deadline)
+{
+    uint64_t now = pet_http_ms();
+    if (now >= deadline) return MBEDTLS_ERR_SSL_TIMEOUT;
+    uint64_t left = deadline - now;
+    struct timeval tv = { .tv_sec = (time_t)(left / 1000),
+        .tv_usec = (suseconds_t)((left % 1000) * 1000) };
+    if (setsockopt(ctx->net.fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv)) < 0)
+        return MBEDTLS_ERR_SSL_TIMEOUT;
+    int ret = mbedtls_ssl_read(&ctx->ssl, buf, cap);
+    if (pet_http_ms() >= deadline) return MBEDTLS_ERR_SSL_TIMEOUT;
+    return ret;
+}
