+/* NSH and SSH consoles need the official line editor, not raw getline.
+ * Only command names/results are logged; never log pairing arguments. */
+static ssize_t bttool_read_command(char** buffer, size_t* size)
+{
+    ssize_t len;
+#if defined(__NuttX__) && defined(CONFIG_SYSTEM_READLINE)
+    if (!*buffer) {
+        *size = CONFIG_NSH_LINELEN;
+        *buffer = malloc(*size);
+        if (!*buffer)
+            return -1;
+    }
+    len = std_readline(*buffer, *size);
+    if (len >= (ssize_t)*size - 1 && (*buffer)[len - 1] != '\n') {
+        /* readline returns a full fragment before EOL. Consume the rest,
+         * otherwise its tail would become an unintended new command. */
+        PRINT("Command too long; discarding through end of line");
+        do {
+            len = std_readline(*buffer, *size);
+        } while (len >= (ssize_t)*size - 1
+            && (*buffer)[len - 1] != '\n');
+        (*buffer)[0] = '\0';
+        return len <= 0 ? -1 : 0;
+    }
+#else
+    len = getline(buffer, size, stdin);
+#endif
+    if (len <= 0)
+        return -1;
+    while (len > 0 && ((*buffer)[len - 1] == '\r'
+        || (*buffer)[len - 1] == '\n' || (*buffer)[len - 1] == ' '
+        || (*buffer)[len - 1] == '\t'))
+        (*buffer)[--len] = '\0';
+    return len;
+}
