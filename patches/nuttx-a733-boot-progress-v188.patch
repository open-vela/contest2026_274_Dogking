@@ -165,15 +166,18 @@
 #endif
 
 #ifdef CONFIG_ARM64_PSCI
-  if (psci_cpu_on(cpu_mpid, (uint64_t)__start))
+  ret = psci_cpu_on(cpu_mpid, (uint64_t)__start);
+  if (ret != 0)
     {
       serr("Failed to boot secondary CPU core %d (MPID:%#lx)\n", cpu_num,
            cpu_mpid);
-      return;
