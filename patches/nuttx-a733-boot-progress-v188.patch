diff --git a/nuttx/arch/arm64/src/common/arm64_head.S b/nuttx/arch/arm64/src/common/arm64_head.S
--- a/nuttx/arch/arm64/src/common/arm64_head.S
+++ b/nuttx/arch/arm64/src/common/arm64_head.S
@@ -358,6 +358,15 @@
  */
 
 boot_stage_puts:
+#ifdef CONFIG_A733_BOOT_DIAGNOSTICS
+    /* Keep CPU0's progress legible. Only assembly banners are suppressed;
+     * secondary fault diagnostics still use the normal early UART path.
+     */
+    get_cpu_id x0
+    cbz   x0, 3f
+    ret
+3:
+#endif
     stp   xzr, x30, [sp, #-16]!
 1:
     ldrb  w0, [x1], #1       /* Load next char */
diff --git a/nuttx/arch/arm64/src/common/arm64_cpustart.c b/nuttx/arch/arm64/src/common/arm64_cpustart.c
