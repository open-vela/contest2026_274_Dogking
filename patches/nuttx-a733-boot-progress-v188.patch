+#ifdef CONFIG_A733_BOOT_DIAGNOSTICS
+      a733_boot_value("SMP return", (int64_t)ret);
+#endif
       if (ret < 0)
         {
           serr("ERROR: Failed to start CPU%d: %d\n", cpu, ret);
