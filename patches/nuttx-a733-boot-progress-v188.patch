@@ -122,7 +126,13 @@
 
   /* Flush dcache before start other CPUs. */
 
+#ifdef CONFIG_A733_BOOT_DIAGNOSTICS
+  a733_boot_value("SMP flush begin", CONFIG_SMP_NCPUS);
+#endif
   up_flush_dcache_all();
+#ifdef CONFIG_A733_BOOT_DIAGNOSTICS
+  a733_boot_value("SMP flush done", 0);
+#endif
 
   /* Start all of the other CPUs.  CPU0 is already running. */
 
@@ -130,7 +140,13 @@
     {
