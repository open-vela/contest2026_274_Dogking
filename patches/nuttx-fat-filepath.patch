+  /* UnQLite and POSIX record locks need the full descriptor path.
+   * Do not forward a file-path request to the block driver. */
+
+  if (cmd == FIOC_FILEPATH)
+    {
+      FAR char *path = (FAR char *)(uintptr_t)arg;
+      size_t used;
+      int written;
+
+      if (path == NULL)
+        {
+          ret = -EINVAL;
+        }
+      else
+        {
+          ret = inode_getpath(inode, path, PATH_MAX);
+          if (ret >= 0)
+            {
+              used = strlen(path);
+              written = snprintf(path + used, PATH_MAX - used,
+                                 "%s%s", used && path[used - 1] == '/' ?
+                                 "" : "/", ff->ff_relpath);
+              ret = written < 0 || (size_t)written >= PATH_MAX - used ?
+                    -ENAMETOOLONG : OK;
+            }
+        }
+    }
+  else
+    {
+      ret = -ENOTTY;
+    }
+
+  nxmutex_unlock(&fs->fs_lock);
+  return ret;
