 /****************************************************************************
  * Name: st7735_fill
@@ -517,18 +697,47 @@
 
 static void st7735_fill(FAR struct st7735_dev_s *dev, uint16_t color)
 {
-  int i;
+  FAR uint16_t *row;
+  int remaining;
 
   st7735_setarea(dev, 0, 0, ST7735_XRES - 1, ST7735_YRES - 1);
 
   st7735_sendcmd(dev, ST7735_RAMWR);
   st7735_select(dev->spi, ST7735_BYTESPP * 8);
 
-  for (i = 0; i < ST7735_XRES * ST7735_YRES; i++)
+  /* Fill one raster line at a time.  Sending one pixel per SPI_SEND() costs a
+   * complete FIFO reset plus register programming in the lower-half for every
+   * pixel, which is thousands of times slower than a block transfer and was
+   * observed to stall the boot while the panel was cleared.
+   */
+
+  row = kmm_malloc(ST7735_XRES * sizeof(uint16_t));
+  if (row == NULL)
     {
-      SPI_SEND(dev->spi, color);
+      /* Fall back to the per-pixel path rather than leaving the panel blank. */
+
+      int i;
+
+      for (i = 0; i < ST7735_XRES * ST7735_YRES; i++)
+        {
+          SPI_SEND(dev->spi, color);
+        }
+
+      st7735_deselect(dev->spi);
+      return;
     }
 
+  for (remaining = 0; remaining < ST7735_XRES; remaining++)
+    {
+      row[remaining] = color;
+    }
+
+  for (remaining = ST7735_YRES; remaining > 0; remaining--)
+    {
+      SPI_SNDBLOCK(dev->spi, row, ST7735_XRES);
+    }
+
+  kmm_free(row);
   st7735_deselect(dev->spi);
 }
 
