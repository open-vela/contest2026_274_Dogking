+/****************************************************************************
+ * Name: st7735_cmd1
+ *
+ * Description:
+ *   Send a command followed by one parameter byte.
+ *
+ ****************************************************************************/
+
+static void st7735_cmd1(FAR struct st7735_dev_s *dev, uint8_t cmd,
+                        uint8_t value)
+{
+  st7735_sendcmd(dev, cmd);
+  st7735_select(dev->spi, 8);
+  SPI_SEND(dev->spi, value);
+  st7735_deselect(dev->spi);
+}
+
+/****************************************************************************
+ * Name: st7735_initseq
+ *
+ * Description:
+ *   Program the panel's frame rate, power, VCOM and gamma blocks.
+ *
+ *   The reference driver that was validated on this exact panel over this
+ *   exact wiring sends this block after SLPOUT; without it the internal
+ *   booster and VCOM are never set up and the panel stays blank even though
+ *   it accepts commands and the backlight is on.
+ *
+ *   The interface pixel format is also forced here.  st7735_bpp() only sends
+ *   COLMOD when dev->bpp changes, so otherwise the colour depth is inherited
+ *   from whatever the controller powered up in.  The ST7735 powers up in
+ *   18-bit mode, and feeding it 16-bit RGB565 while it expects 18 bpp
+ *   interleaves the bytes: the picture is correct in shape but every row
+ *   breaks into fine vertical colour stripes.
+ *
+ ****************************************************************************/
+
+static void st7735_initseq(FAR struct st7735_dev_s *dev)
+{
+  /* Frame rate control: normal / idle / partial mode */
+
+  st7735_sendcmd(dev, ST7735_CMD_FRMCTR1);
+  st7735_select(dev->spi, 8);
+  SPI_SEND(dev->spi, 0x01);
+  SPI_SEND(dev->spi, 0x2c);
+  SPI_SEND(dev->spi, 0x2d);
+  st7735_deselect(dev->spi);
+
+  st7735_sendcmd(dev, ST7735_CMD_FRMCTR2);
+  st7735_select(dev->spi, 8);
+  SPI_SEND(dev->spi, 0x01);
+  SPI_SEND(dev->spi, 0x2c);
+  SPI_SEND(dev->spi, 0x2d);
+  st7735_deselect(dev->spi);
+
+  st7735_sendcmd(dev, ST7735_CMD_FRMCTR3);
+  st7735_select(dev->spi, 8);
+  SPI_SEND(dev->spi, 0x01);
+  SPI_SEND(dev->spi, 0x2c);
+  SPI_SEND(dev->spi, 0x2d);
+  SPI_SEND(dev->spi, 0x01);
+  SPI_SEND(dev->spi, 0x2c);
+  SPI_SEND(dev->spi, 0x2d);
+  st7735_deselect(dev->spi);
+
+  /* Display inversion control: 3-dot inversion */
+
+  st7735_cmd1(dev, ST7735_CMD_INVCTR, 0x07);
+
+  /* Power control */
+
+  st7735_sendcmd(dev, ST7735_CMD_PWCTR1);
+  st7735_select(dev->spi, 8);
+  SPI_SEND(dev->spi, 0xa2);
+  SPI_SEND(dev->spi, 0x02);
+  SPI_SEND(dev->spi, 0x84);
+  st7735_deselect(dev->spi);
+
+  st7735_cmd1(dev, ST7735_CMD_PWCTR2, 0xc5);
+
+  st7735_sendcmd(dev, ST7735_CMD_PWCTR3);
+  st7735_select(dev->spi, 8);
+  SPI_SEND(dev->spi, 0x0a);
+  SPI_SEND(dev->spi, 0x00);
+  st7735_deselect(dev->spi);
+
+  st7735_sendcmd(dev, ST7735_CMD_PWCTR4);
+  st7735_select(dev->spi, 8);
+  SPI_SEND(dev->spi, 0x8a);
+  SPI_SEND(dev->spi, 0x2a);
+  st7735_deselect(dev->spi);
+
+  st7735_sendcmd(dev, ST7735_CMD_PWCTR5);
+  st7735_select(dev->spi, 8);
+  SPI_SEND(dev->spi, 0x8a);
+  SPI_SEND(dev->spi, 0xee);
+  st7735_deselect(dev->spi);
+
+  /* VCOM */
+
+  st7735_cmd1(dev, ST7735_CMD_VMCTR1, 0x0e);
+
+  /* Interface pixel format: (bpp >> 2) | 1  =>  0x05 for 16 bpp.
+   * Never inherit it from a previous run.
+   */
+
+  st7735_cmd1(dev, ST7735_COLMOD, (ST7735_BPP >> 2) | 1);
+
+  /* Gamma */
+
+  st7735_sendcmd(dev, ST7735_CMD_GMCTRP1);
+  st7735_select(dev->spi, 8);
+  SPI_SEND(dev->spi, 0x02);
+  SPI_SEND(dev->spi, 0x1c);
+  SPI_SEND(dev->spi, 0x07);
+  SPI_SEND(dev->spi, 0x12);
+  SPI_SEND(dev->spi, 0x37);
+  SPI_SEND(dev->spi, 0x32);
+  SPI_SEND(dev->spi, 0x29);
+  SPI_SEND(dev->spi, 0x2d);
+  SPI_SEND(dev->spi, 0x29);
+  SPI_SEND(dev->spi, 0x25);
+  SPI_SEND(dev->spi, 0x2b);
+  SPI_SEND(dev->spi, 0x39);
+  SPI_SEND(dev->spi, 0x00);
+  SPI_SEND(dev->spi, 0x01);
+  SPI_SEND(dev->spi, 0x03);
+  SPI_SEND(dev->spi, 0x10);
+  st7735_deselect(dev->spi);
+
+  st7735_sendcmd(dev, ST7735_CMD_GMCTRN1);
+  st7735_select(dev->spi, 8);
+  SPI_SEND(dev->spi, 0x03);
+  SPI_SEND(dev->spi, 0x1d);
+  SPI_SEND(dev->spi, 0x07);
+  SPI_SEND(dev->spi, 0x06);
+  SPI_SEND(dev->spi, 0x2e);
+  SPI_SEND(dev->spi, 0x2c);
+  SPI_SEND(dev->spi, 0x29);
+  SPI_SEND(dev->spi, 0x2d);
+  SPI_SEND(dev->spi, 0x2e);
+  SPI_SEND(dev->spi, 0x2e);
+  SPI_SEND(dev->spi, 0x37);
+  SPI_SEND(dev->spi, 0x3f);
+  SPI_SEND(dev->spi, 0x00);
+  SPI_SEND(dev->spi, 0x00);
+  SPI_SEND(dev->spi, 0x02);
+  SPI_SEND(dev->spi, 0x10);
+  st7735_deselect(dev->spi);
+
+  ginfo("st7735: panel setup (frmctr/pwctr/vmctr/gamma/colmod) sent\n");
+}
