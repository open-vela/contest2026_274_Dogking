--- a/nuttx/drivers/lcd/st7735.c
+++ b/nuttx/drivers/lcd/st7735.c
@@ -204,5 +204,7 @@ static void st7735_bpp(FAR struct st7735_dev_s *dev, int bpp);
 static void st7735_wrram(FAR struct st7735_dev_s *dev,
                          FAR const uint16_t *buff, size_t size);
+#ifndef CONFIG_LCD_NOGETRUN
 static void st7735_rdram(FAR struct st7735_dev_s *dev,
                          FAR uint16_t *buff, size_t size);
+#endif
 static void st7735_fill(FAR struct st7735_dev_s *dev, uint16_t color);
@@ -492 +494,2 @@ static void st7735_wrram(FAR struct st7735_dev_s *dev,
+#ifndef CONFIG_LCD_NOGETRUN
 /****************************************************************************
@@ -508 +511,2 @@ static void st7735_rdram(FAR struct st7735_dev_s *dev,
 }
+#endif
@@ -518,16 +522,23 @@
-static void st7735_fill(FAR struct st7735_dev_s *dev, uint16_t color)
-{
-  int i;
-
-  st7735_setarea(dev, 0, 0, ST7735_XRES - 1, ST7735_YRES - 1);
-
-  st7735_sendcmd(dev, ST7735_RAMWR);
-  st7735_select(dev->spi, ST7735_BYTESPP * 8);
-
-  for (i = 0; i < ST7735_XRES * ST7735_YRES; i++)
-    {
-      SPI_SEND(dev->spi, color);
-    }
-
-  st7735_deselect(dev->spi);
-}
+static void st7735_fill(FAR struct st7735_dev_s *dev, uint16_t color)
+{
+  uint16_t line[ST7735_XRES];
+  int row;
+  int col;
+
+  st7735_setarea(dev, 0, 0, ST7735_XRES - 1, ST7735_YRES - 1);
+
+  st7735_sendcmd(dev, ST7735_RAMWR);
+  st7735_select(dev->spi, ST7735_BYTESPP * 8);
+
+  for (col = 0; col < ST7735_XRES; col++)
+    {
+      line[col] = color;
+    }
+
+  for (row = 0; row < ST7735_YRES; row++)
+    {
+      SPI_SNDBLOCK(dev->spi, line, ST7735_XRES);
+    }
+
+  st7735_deselect(dev->spi);
+}
@@ -557 +561 @@ static int st7735_putrun(FAR struct lcd_dev_s *dev,
-  ginfo("row: %d col: %d npixels: %d\n", row, col, npixels);
+  ginfo("row: %d col: %d npixels: %zu\n", row, col, npixels);
@@ -588 +592 @@ static int st7735_getrun(FAR struct lcd_dev_s *dev,
-  ginfo("row: %d col: %d npixels: %d\n", row, col, npixels);
+  ginfo("row: %d col: %d npixels: %zu\n", row, col, npixels);
