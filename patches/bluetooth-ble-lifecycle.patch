+static int stop_scan_cmd(void* handle, int argc, char* argv[])
+{
+    pthread_mutex_lock(&g_scan_lock);
+    if (!g_scanner) {
+        pthread_mutex_unlock(&g_scan_lock);
+        PRINT("Scan already stopped");
+        return CMD_OK;
+    }
+    if (!g_scan_stopping) {
+        g_scan_stopping = true;
+        /* API is void: acceptance alone is not completion. Keep the pointer
+         * until STOPPED, and never free the framework-owned wrapper here. */
+        bt_le_stop_scan(handle, g_scanner);
+        PRINT("Scan stop requested; wait for on_scan_stopped_cb");
+    } else {
+        PRINT("Scan stop already pending");
+    }
+    pthread_mutex_unlock(&g_scan_lock);
+    return CMD_OK;
+}
