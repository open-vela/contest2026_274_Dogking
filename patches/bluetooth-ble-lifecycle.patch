+static int enable_cmd(void* handle, int argc, char** argv)
+{
+    bt_adapter_state_t state = bt_adapter_get_state(handle);
+    bt_status_t status;
+    if (bttool_adapter_ready(state)) {
+        bt_tool_init(handle);
+        PRINT("Adapter already enabled: state=%d", state);
+        return CMD_OK;
+    }
+    if (state != BT_ADAPTER_STATE_OFF && state != BT_ADAPTER_STATE_BLE_ON) {
+        PRINT("Enable blocked: transition pending, state=%d", state);
+        return CMD_ERROR;
+    }
+    status = bt_adapter_enable(handle);
+    PRINT("enable API status=%d; completion is the state callback", status);
+    return status == BT_STATUS_SUCCESS || status == BT_STATUS_DONE ? CMD_OK : CMD_ERROR;
+}
+
+static int disable_cmd(void* handle, int argc, char** argv)
+{
+    bt_adapter_state_t state = bt_adapter_get_state(handle);
+    bt_status_t status;
+    if (state == BT_ADAPTER_STATE_OFF) {
+        PRINT("Adapter already disabled");
+        return CMD_OK;
+    }
+    if (state == BT_ADAPTER_STATE_BLE_TURNING_OFF || state == BT_ADAPTER_STATE_TURNING_OFF) {
+        PRINT("Disable already pending: state=%d", state);
+        return CMD_OK;
+    }
+    if (state != BT_ADAPTER_STATE_BLE_ON && state != BT_ADAPTER_STATE_ON) {
+        PRINT("Disable blocked: transition pending, state=%d", state);
+        return CMD_ERROR;
+    }
+#ifdef CONFIG_BLUETOOTH_BLE_SCAN
+    scan_command_uninit(handle);
+#endif
+    status = bt_adapter_disable_safe(handle);
+    PRINT("disable API status=%d; wait for OFF(0)", status);
+    return status == BT_STATUS_SUCCESS || status == BT_STATUS_DONE ? CMD_OK : CMD_ERROR;
+}
