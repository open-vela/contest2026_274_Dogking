    "thanks": {"keywords": ["谢谢", "感谢", "多谢", "谢谢小派"], "actions": ["不客气！能帮到你我很开心~", "嘻嘻，不用谢！"]},
    "weather": {"keywords": ["天气", "气温", "下雨", "刮风", "多少度"], "actions": ["这个嘛…我暂时查不到天气，不过你可以看看窗外~"]}
