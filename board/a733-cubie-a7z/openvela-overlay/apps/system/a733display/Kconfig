config SYSTEM_A733DISPLAY
	tristate "Cubie A7Z LVGL display utility"
	default n
	depends on GRAPHICS_LVGL
	depends on LV_USE_NUTTX_LCD
	---help---
		Build the lightweight display command using official LVGL with the
		A733 direct ST7735 RGB565 flush path.  It provides hardware tests and
		the stable display-owner entry point for the AI pet UI without pulling
		in the complete LVGL demo asset collection.

if SYSTEM_A733DISPLAY

config A733DISPLAY_PROGNAME
	string "Program name"
	default "display"

config A733DISPLAY_PRIORITY
	int "Task priority"
	default 100

config A733DISPLAY_STACKSIZE
	int "Task stack size"
	default 32768

endif
