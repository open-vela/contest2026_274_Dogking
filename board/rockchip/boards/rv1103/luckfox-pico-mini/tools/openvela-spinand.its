/* SPDX-License-Identifier: Apache-2.0 */

/dts-v1/;
/ {
  description = "openvela for Luckfox Pico Mini SPI NAND";
  #address-cells = <1>;

  images {
    fdt {
      data = /incbin/("board.dtb");
      type = "flat_dt";
      arch = "arm";
      compression = "none";
      load = <0xffffff00>;
      hash {
        algo = "sha256";
      };
    };

    kernel {
      description = "openvela-rv1103";
      data = /incbin/("openvela.bin");
      type = "kernel";
      arch = "arm";
      os = "linux";
      compression = "none";
      load = <0x00800000>;
      entry = <0x00800000>;
      hash {
        algo = "sha256";
      };
    };

    resource {
      data = /incbin/("resource.img");
      type = "multi";
      arch = "arm";
      compression = "none";
      hash {
        algo = "sha256";
      };
    };
  };

  configurations {
    default = "conf";
    conf {
      description = "Boot openvela with the official RV1103 device tree";
      rollback-index = <0x00>;
      fdt = "fdt";
      kernel = "kernel";
      multi = "resource";
      signature {
        algo = "sha256,rsa2048";
        padding = "pss";
        key-name-hint = "dev";
        sign-images = "fdt", "kernel", "multi";
      };
    };
  };
};
