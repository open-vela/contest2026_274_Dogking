# Build products
build/
out/
cmake_out/
__pycache__/
archives/
build-temp-backups/
*.o
*.a
*.elf
*.hex
*.map

# Large local deployment artifacts
*.img
*.img.xz
*.img.gz
*.nb
*.a7pm
*.a7tv
*.bin
*.tar
*.tar.gz
*.zip
*.bundle

# Secrets and local service state
*.key
*.pem
*.p12
*.crt
*.password
*.credentials
.env

# Editor/OS state
.vscode/
.idea/
.DS_Store
Thumbs.db

# AI logs are contest deliverables and must not be ignored.
!logs/**/*.jsonl
!logs/**/manifest.json

# Only the three sealed v204 evidence records, NOT general build products.
!docs/evidence/camera-v204-final/build/
docs/evidence/camera-v204-final/build/*
!docs/evidence/camera-v204-final/build/build.log
!docs/evidence/camera-v204-final/build/sdk-restored.json
!docs/evidence/camera-v204-final/build/wrapper-status.txt

