# Build products
build/
out/
cmake_out/
archives/
build-temp-backups/
*.o
*.a
*.elf
*.hex
*.map

# Large local deployment artifacts
*.img
*.img.xz
*.img.gz
*.nb
*.a7pm
*.bin
*.tar
*.tar.gz
*.zip
