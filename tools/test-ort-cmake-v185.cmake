# HOST configure-contract test only; no SDK, firmware or board writes.
cmake_minimum_required(VERSION 3.24)
set(CONFIG_EXAMPLES_AI_AGENT_VELA y)
set(CONFIG_A733_CPU_ACOUSTIC y)
set(CONFIG_LIBC_MAX_EXITFUNS 0)
set(CONFIG_LIBCXX y)
set(CONFIG_CXX_STANDARD "gnu++17")
set(CONFIG_CXX_MINI_LOCALIZATION y)
set(CONFIG_CXX_WCHAR y)
set(CONFIG_BUILD_FLAT y)
if(TEST_BAD_ABI)
  set(CONFIG_CXX_WCHAR n)
endif()
function(nuttx_add_extra_library path)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "Missing real archive")
  endif()
  set_property(GLOBAL APPEND PROPERTY TEST_ARCHIVES "${path}")
endfunction()
function(nuttx_add_application)
  set_property(GLOBAL PROPERTY TEST_APPLICATION "${ARGV}")
endfunction()
include("${CMAKE_CURRENT_LIST_DIR}/../board/a733-cubie-a7z/openvela-overlay/apps/system/aipet/CMakeLists.txt")
get_property(archives GLOBAL PROPERTY TEST_ARCHIVES)
list(LENGTH archives count)
if(count LESS 3)
  message(FATAL_ERROR "No static runtime imports")
endif()
message(STATUS "PASS: ${count} SHA-verified real NuttX archives configured; NOT a firmware link")
